{
  "name": "notcompose",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/notcompose/index.d.ts",
      "import": "./dist/notcompose/index.js"
    },
    "./molecule": {
      "types": "./dist/notcompose-molecule/index.d.ts",
      "import": "./dist/notcompose-molecule/index.js"
    },
    "./layout": {
      "types": "./dist/notcompose-layout/index.d.ts",
      "import": "./dist/notcompose-layout/index.js"
    },
    "./terminal": {
      "types": "./dist/notcompose-terminal/index.d.ts",
      "import": "./dist/notcompose-terminal/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
