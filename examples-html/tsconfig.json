{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true,

    "rootDir": "src",
    "outDir": "./build/dist",
    "noEmit": true,

    "types": ["vite/client"],
    "lib": ["es2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./build/.tsbuildinfo",
  },
  "include": ["src/**/*.ts"]
}
