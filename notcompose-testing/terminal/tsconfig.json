{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./build/dist",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,

    "types": ["node"],
    "lib": ["es2022", "ESNext.Disposable"],
    "tsBuildInfoFile": "./build/.tsbuildinfo",
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../notcompose" },
    { "path": "../../notcompose-layout" },
    { "path": "../../notcompose-ui" },
    { "path": "../../notcompose-terminal" },
    { "path": "../../notcompose-testing/core" },
    { "path": "../../notcompose-testing/layout" },
    { "path": "../../notcompose-testing/ui" },
  ]
}
