{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true,

    "rootDir": "src",
    "outDir": "./build/dist",

    "types": ["node"],
    "lib": ["es2022", "ESNext.Disposable"],
    "tsBuildInfoFile": "./build/.tsbuildinfo",
  },
  "include": ["src/**/*.ts"]
}
