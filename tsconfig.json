{
    "compilerOptions": {
        "types": ["node"],
        "lib": ["es2024", "DOM", "DOM.Iterable", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],

        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",

        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "notcompose": ["./src/notcompose/index.ts"],
            "notcompose/molecule": ["./src/notcompose-molecule/index.ts"],
            "notcompose/html": ["./src/notcompose-html/index.ts"],
            "notcompose/layout": ["./src/notcompose-layout/index.ts"],
            "notcompose/terminal": ["./src/notcompose-terminal/index.ts"]
        },

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "incremental": true,
        "allowJs": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["./src"]
}
